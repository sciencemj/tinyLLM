# Copy to scripts/gcp/env (scripts/gcp/.gitignore ignores it; never commit it) and fill in.
# This file holds NO secrets. WANDB_API_KEY lives only in Secret Manager.
PROJECT=your-gcp-project-id
REGION=us-central1
ZONE=us-central1-a
BUCKET=your-unique-bucket-name          # gs://$BUCKET/data/v2 and gs://$BUCKET/ckpt/<tag>
GPU_TYPE=l4                             # h100 -> a3-highgpu-1g, l4 -> g2-standard-8
REPO_URL=https://github.com/sciencemj/tinyLLM.git
BRANCH=feat/tinyllm-v2                  # the VM checks out the commit HEAD had when the template was created

# What to train (hydra keys; see configs/)
MODEL=main                              # configs/model/*.yaml
DATA=fineweb                            # configs/data/*.yaml
RUN=pretrain                            # configs/run/*.yaml
INIT_FROM=                              # optional run.init_from, e.g. /mnt/ckpt/<pretrain-tag>/best.ckpt for SFT
TAG=pretrain-main-1                     # fixes the W&B run id and the checkpoint dir

# Names
SECRET_NAME=tinyllm-wandb-api-key
MIG_NAME=tinyllm-mig
TEMPLATE_NAME=tinyllm-template
PREPARE_VM=tinyllm-prepare
ROUTER_NAME=tinyllm-router              # Cloud Router and NAT for VMs without external IPs
NAT_NAME=tinyllm-nat
FALLBACK_VM=tinyllm-fallback-vm         # single spot VM if a MIG does not work with the GPU machine type
SERVICE_ACCOUNT=                        # optional; default compute SA needs roles/storage.objectAdmin,
                                        # roles/secretmanager.secretAccessor and roles/compute.instanceAdmin.v1

# Image must ship an NVIDIA driver new enough for the locked torch (CUDA 13: driver 580 line).
# Before creating any VM run: gcloud compute images describe-from-family "$IMAGE_FAMILY" --project "$IMAGE_PROJECT"
IMAGE_PROJECT=deeplearning-platform-release
IMAGE_FAMILY=common-cu129-ubuntu-2204-nvidia-580
MAX_TOKENS=20000000000                  # FineWeb train tokens for corpus prep
BOOT_DISK_GB=300                        # >= 80GB data + OS + uv/torch env
